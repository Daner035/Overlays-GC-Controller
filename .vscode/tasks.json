{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Overlay VK DLL (UCRT64)",
      "type": "shell",
      "command": "D:\\Archivos de programas\\msys64\\ucrt64\\bin\\g++.exe",
      "args": [
        "-std=c++17",
        "-m64",
        "-shared",
        "-O2",
        "-IOverlay_vk_dll",
        "-IC:/VulkanSDK/1.4.363.1/Include",
        "-IOverlay_vk_dll/third_party/imgui",
        "-IOverlay_vk_dll/third_party/imgui/backends",
        "-IOverlay_vk_dll/third_party/minhook/include",
        "Overlay_vk_dll/dllmain.cpp",
        "Overlay_vk_dll/third_party/imgui/imgui.cpp",
        "Overlay_vk_dll/third_party/imgui/imgui_draw.cpp",
        "Overlay_vk_dll/third_party/imgui/imgui_tables.cpp",
        "Overlay_vk_dll/third_party/imgui/imgui_widgets.cpp",
        "Overlay_vk_dll/third_party/imgui/backends/imgui_impl_win32.cpp",
        "Overlay_vk_dll/third_party/imgui/backends/imgui_impl_vulkan.cpp",
        "-o",
        "Overlay_vk_dll/test_overlay.dll",
        "Overlay_vk_dll/third_party/minhook/src/buffer.c",
        "Overlay_vk_dll/third_party/minhook/src/hook.c",
        "Overlay_vk_dll/third_party/minhook/src/trampoline.c",
        "Overlay_vk_dll/third_party/minhook/src/hde/hde32.c",
        "Overlay_vk_dll/third_party/minhook/src/hde/hde64.c",
        "-LC:/VulkanSDK/1.4.363.1/Lib",
        "-lvulkan-1",
        "-lws2_32",
        "-lgdi32",
        "-ldwmapi",
        "-static-libgcc",
        "-static-libstdc++"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "D:\\Archivos de programas\\msys64\\ucrt64\\bin;${env:PATH}"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}